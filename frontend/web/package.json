{
  "name": "@teampulse/web",
  "version": "1.0.0",
  "private": true,
  "description": "TeamPulse dashboard — SvelteKit (Svelte 5 runes) SPA for employees, managers and admins.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:unit": "vitest",
    "ui:build": "npm --prefix ../ui-components run build"
  },
  "dependencies": {
    "@teampulse/ui-components": "file:../ui-components"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.19.2",
    "jsdom": "^27.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
