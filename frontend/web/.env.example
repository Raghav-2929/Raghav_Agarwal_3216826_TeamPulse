# Base URL prepended to every API call. Leave empty in production: CloudFront routes /api/* to the
# gateway on the same origin. In dev the Vite proxy forwards /api and /.well-known to the gateway.
PUBLIC_API_BASE_URL=

# Dev/preview proxy target (read by vite.config.ts, not exposed to the browser).
TEAMPULSE_GATEWAY_URL=http://localhost:8000
