{
  "name": "@teampulse/ui-components",
  "version": "1.0.0",
  "description": "TeamPulse design tokens and framework-agnostic web components (leaderboard table, progress ring, progress card, trend chart, badge, stat tile) built with StencilJS.",
  "keywords": [
    "teampulse",
    "web-components",
    "custom-elements",
    "stencil",
    "design-tokens",
    "wellness",
    "charts"
  ],
  "license": "MIT",
  "author": "TeamPulse",
  "repository": {
    "type": "git",
    "url": "https://github.com/teampulse/teampulse.git",
    "directory": "frontend/ui-components"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/teampulse/teampulse.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/components/index.js"
  ],
  "files": [
    "dist/",
    "loader/",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "stencil build --docs",
    "postbuild": "node scripts/copy-tokens.cjs",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec",
    "test:watch": "stencil test --spec --watchAll",
    "clean": "node -e \"for (const d of ['dist','loader','www']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@stencil/core": "^4.45.2",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0"
  }
}
