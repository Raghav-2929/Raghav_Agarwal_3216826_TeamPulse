# syntax=docker/dockerfile:1.7
# Streak processor as an AWS Lambda container image (pushed to ECR, triggered by EventBridge).
# Build from the repository root:
#   docker build -f services/streak-processor/Dockerfile.lambda -t teampulse/streak-processor-lambda .
FROM ghcr.io/astral-sh/uv:0.11.7 AS uv

FROM public.ecr.aws/lambda/python:3.13 AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /build
COPY pyproject.toml uv.lock ./
COPY libs ./libs
COPY services ./services
RUN uv export --frozen --no-dev --no-editable --no-hashes --package teampulse-streak-processor -o requirements.txt \
 && uv pip install --python /var/lang/bin/python3.13 --target /opt/package -r requirements.txt

FROM public.ecr.aws/lambda/python:3.13
LABEL org.opencontainers.image.title="teampulse-streak-processor-lambda"
COPY --from=build /opt/package ${LAMBDA_TASK_ROOT}
ENV SERVICE_NAME=streak-processor LOG_FORMAT=json ANALYTICS_STORE_DRIVER=dynamodb EVENT_BUS_DRIVER=eventbridge
CMD ["streak_processor.handler.lambda_handler"]
