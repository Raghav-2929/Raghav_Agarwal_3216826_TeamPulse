# Copy to .env and adjust. Every setting is an environment variable (12-factor); in AWS the same names
# are injected by the ECS task definition (plain values) and AWS Secrets Manager (secrets).

# ---- docker compose
TAG=latest
POSTGRES_PASSWORD=postgres-local
SERVICE_DB_PASSWORD=teampulse-local
# Optional: a PEM RSA key for identity-service (else one is generated and kept in its volume)
JWT_PRIVATE_KEY=

# ---- common to every service (defaults shown)
# ENVIRONMENT=local                    # local | docker | aws | test
# LOG_LEVEL=INFO
# LOG_FORMAT=console                   # console | json
# METRICS_EMF=false                    # CloudWatch Embedded Metric Format (true in AWS)
# OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g. http://localhost:4318 (Jaeger) — tracing off when empty
# DATABASE_URL=                        # full SQLAlchemy URL, or DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD/DB_SSL
# AUTO_CREATE_SCHEMA=true              # false where Alembic migrations run (docker/aws)
# JWT_ISSUER=teampulse-identity
# JWT_AUDIENCE=teampulse
# JWT_JWKS_URL=http://localhost:8001/.well-known/jwks.json
# EVENT_BUS_DRIVER=memory              # memory | direct | rabbitmq | eventbridge
# EVENT_BUS_NAME=teampulse-events      # EventBridge bus (aws)
# EVENT_QUEUE_URL=                     # SQS queue this service consumes (aws)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# CONSUL_URL=                          # enables self-registration (docker)
# CORS_ORIGINS=http://localhost:5173
# AWS_REGION=eu-west-1
# AWS_ENDPOINT_URL=                    # DynamoDB Local / LocalStack

# ---- service specific
# identity-service:      JWT_PRIVATE_KEY, JWT_KEY_ID, ACCESS_TOKEN_TTL_SECONDS=900, REFRESH_TOKEN_TTL_DAYS=7,
#                        MAX_FAILED_LOGINS=5, LOCKOUT_MINUTES=15, SEED_DEMO_DATA=true
# event-tracking:        HABIT_SERVICE_URL, ACTIVITY_BACKFILL_DAYS=7
# insight / processor:   ANALYTICS_STORE_DRIVER=sql|dynamodb, ANALYTICS_TABLE_NAME=teampulse-analytics,
#                        ANALYTICS_DATABASE_URL, MIN_COHORT_SIZE=3
# notification-service:  REMINDER_SCHEDULER=internal|external, REMINDER_INTERVAL_SECONDS=300
# gateway:               *_SERVICE_URL, SERVICE_DISCOVERY=static|consul, RATE_LIMIT_PER_MINUTE=300,
#                        LOGIN_RATE_LIMIT_PER_MINUTE=10, MAX_BODY_BYTES=1048576, UPSTREAM_TIMEOUT_SECONDS=10
