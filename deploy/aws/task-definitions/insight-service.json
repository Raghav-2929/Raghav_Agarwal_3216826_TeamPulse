{
  "family": "teampulse-insight-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/teampulse-insight-service-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/teampulse-insight-service-task",
  "containerDefinitions": [
    {
      "name": "insight-service",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/teampulse/insight-service:<IMAGE_TAG>",
      "essential": true,
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "aws"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "LOG_FORMAT",
          "value": "json"
        },
        {
          "name": "METRICS_EMF",
          "value": "true"
        },
        {
          "name": "AWS_REGION",
          "value": "<REGION>"
        },
        {
          "name": "AUTO_CREATE_SCHEMA",
          "value": "false"
        },
        {
          "name": "JWT_ISSUER",
          "value": "teampulse-identity"
        },
        {
          "name": "JWT_AUDIENCE",
          "value": "teampulse"
        },
        {
          "name": "JWT_JWKS_URL",
          "value": "http://identity-service:8000/.well-known/jwks.json"
        },
        {
          "name": "EVENT_BUS_DRIVER",
          "value": "eventbridge"
        },
        {
          "name": "EVENT_BUS_NAME",
          "value": "teampulse-events"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://<CLOUDFRONT_DOMAIN>"
        },
        {
          "name": "DATA_DIR",
          "value": "/tmp"
        },
        {
          "name": "SERVICE_NAME",
          "value": "insight-service"
        },
        {
          "name": "ANALYTICS_STORE_DRIVER",
          "value": "dynamodb"
        },
        {
          "name": "ANALYTICS_TABLE_NAME",
          "value": "teampulse-analytics"
        },
        {
          "name": "MIN_COHORT_SIZE",
          "value": "3"
        }
      ],
      "readonlyRootFilesystem": true,
      "mountPoints": [
        {
          "sourceVolume": "tmp",
          "containerPath": "/tmp"
        }
      ],
      "user": "10001",
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2).status == 200 else 1)"
        ],
        "interval": 15,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/teampulse/insight-service",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "tmp"
    }
  ]
}
