{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAnalyticsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": "arn:aws:dynamodb:<REGION>:<ACCOUNT_ID>:table/teampulse-analytics"
    },
    {
      "Sid": "PublishDerivedEvents",
      "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:<REGION>:<ACCOUNT_ID>:event-bus/teampulse-events"
    },
    {
      "Sid": "OnFailureDestination",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:<REGION>:<ACCOUNT_ID>:teampulse-streak-processor-dlq"
    }
  ]
}
