  "components": {
    "schemas": {
      "BadgeCriterion": {
        "type": "string",
        "enum": [
          "streak_days",
          "total_completions",
          "category_completions"
        ],
        "title": "BadgeCriterion"
      },
      "BadgeRule": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9_]{3,40}$",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 2,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "title": "Description",
            "default": ""
          },
          "icon": {
            "type": "string",
            "maxLength": 8,
            "title": "Icon",
            "default": "🏅"
          },
          "criterion": {
            "$ref": "#/components/schemas/BadgeCriterion"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Threshold"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "criterion",
          "threshold"
        ],
        "title": "BadgeRule"
      },
      "BadgeRuleIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 2,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "title": "Description",
            "default": ""
          },
          "icon": {
            "type": "string",
            "maxLength": 8,
            "title": "Icon",
            "default": "🏅"
          },
          "criterion": {
            "$ref": "#/components/schemas/BadgeCriterion"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Threshold"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "criterion",
          "threshold"
        ],
        "title": "BadgeRuleIn"
      },
      "Category": {
        "type": "string",
        "enum": [
          "fitness",
          "mindfulness",
          "nutrition",
          "sleep",
          "hydration",
          "learning"
        ],
        "title": "Category"
      },
      "ChallengeCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ],
            "description": "Restrict to one activity type (null = any)"
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Id",
            "description": "Team-only challenge (null = organisation-wide)"
          },
          "starts_on": {
            "type": "string",
            "format": "date",
            "title": "Starts On"
          },
          "ends_on": {
            "type": "string",
            "format": "date",
            "title": "Ends On"
          },
          "target_count": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Target Count",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "title",
          "starts_on",
          "ends_on"
        ],
        "title": "ChallengeCreate"
      },
      "ChallengeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ]
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Id"
          },
          "team_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Name"
          },
          "starts_on": {
            "type": "string",
            "format": "date",
            "title": "Starts On"
          },
          "ends_on": {
            "type": "string",
            "format": "date",
            "title": "Ends On"
          },
          "target_count": {
            "type": "integer",
            "title": "Target Count"
          },
          "status": {
            "$ref": "#/components/schemas/ChallengeStatus"
          },
          "created_by": {
            "type": "string",
            "format": "uuid",
            "title": "Created By"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "participant_count": {
            "type": "integer",
            "title": "Participant Count"
          },
          "joined": {
            "type": "boolean",
            "title": "Joined"
          },
          "my_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "My Score"
          },
          "my_goal_reached": {
            "type": "boolean",
            "title": "My Goal Reached"
          },
          "show_on_leaderboard": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Show On Leaderboard"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "category",
          "team_id",
          "team_name",
          "starts_on",
          "ends_on",
          "target_count",
          "status",
          "created_by",
          "created_at",
          "participant_count",
          "joined",
          "my_score",
          "my_goal_reached",
          "show_on_leaderboard"
        ],
        "title": "ChallengeOut"
